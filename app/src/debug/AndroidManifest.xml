<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The receiver requires android.permission.DUMP, which adb shell
     holds and ordinary apps cannot obtain, so only a developer at a connected
     computer can send commands. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.jagadeeshm007.pin.debug.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
