<?xml version="1.0" encoding="utf-8"?>
<!-- Exported components: the launcher activity, and the accessibility service, which
     only the system can bind (BIND_ACCESSIBILITY_SERVICE).
     Backup is off: history, screenshots and keys never leave the device. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Speech model downloads (PIN-20) and, later, the user's LLM provider. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Listening session (PIN-21): microphone foreground service in the :speech process. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Task notification (PIN-13). Promoted Live Updates need the normal permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Lets "open YouTube" resolve launchable apps (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pin">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".accessibility.PinAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ADR-0007: speech runs in its own process so a native crash cannot stop device control. -->
        <service
            android:name=".speech.ListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:process=":speech" />

        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
